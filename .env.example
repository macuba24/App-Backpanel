# PostgreSQL Windows service on this PC (postgresql-x64-16, port 5432, database backpanel).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/backpanel?schema=public"
# Address other devices in the shop use. scripts/install-shop.ps1 rewrites these.
NEXT_PUBLIC_PANEL_URL="http://192.168.178.124:3000"
NEXT_PUBLIC_SCHMAHL_APP_URL="http://192.168.178.124:8765/"
SESSION_SECRET="replace-with-a-long-random-string"
# One key for the operator app. It is accepted by every backpanel, in addition to that shop's own key.
MASTER_API_KEY="replace-with-a-long-random-string"
